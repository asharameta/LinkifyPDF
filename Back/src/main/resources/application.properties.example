spring.datasource.url=jdbc:postgresql://localhost:5432/LinkifyPDF
spring.datasource.username={username}
spring.datasource.password={password}
spring.datasource.driver=org.postgresql.Driver

spring.mvc.throw-exception-if-no-handler-found=true
spring.web.resources.add-mappings=false

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=20MB
# Path to the directory where uploaded PDFs are stored (must end without trailing slash)
spring.servlet.multipart.location={absolute_path_to_pdf_storage_directory}